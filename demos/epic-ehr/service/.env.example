API_BEARER_TOKEN=replace-with-a-secret-from-key-vault
EPIC_BACKEND=fixture
EPIC_FIXTURE_ROOT=..\fixtures
EPIC_FILE_ROOTS=..\fixtures\files

# Live mode only
# EPIC_BACKEND=copilot
# EPIC_COMPUTER_USE_ENABLED=1
# EPIC_ORIGIN=https://epic.example.invalid
# Authenticated chart URL prefix used to detect expired/login-page sessions.
# EPIC_READY_URL_PREFIX=https://epic.example.invalid/chart
# EPIC_BROWSER_CDP_URL=http://127.0.0.1:9222
# Optional exact tab title (omit when chart navigation changes it)
# EPIC_BROWSER_WINDOW_TITLE=Epic
# Isolated CLI runtime authentication (never commit the token).
# COPILOT_GITHUB_TOKEN=
# Optional Azure BYOM instead: Entra ID via DefaultAzureCredential, no API keys.
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
# Copilot model name, or actual Azure deployment name when using BYOM.
MODEL_DEPLOYMENT=gpt-6-astra
# EPIC_MAX_BROWSER_STEPS=40
# EPIC_SKILL_TIMEOUT_SECONDS=180
# EPIC_CACHE_TTL_SECONDS=900
# EPIC_CACHE_MAX_ENTRIES=16
# EPIC_CACHE_MAX_BYTES=8388608
