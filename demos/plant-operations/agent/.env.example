# === SRE Agent Configuration ===
# Copy this file to .env and fill in your values.
# The run.ps1 / serve.ps1 scripts will load these automatically.

# (Required) Azure AI Foundry endpoint URL
# Get this from: Azure Portal > AI Foundry resource > Overview > Endpoint
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com

# (Required) API key for Azure AI Foundry
# Get this from: Azure Portal > AI Foundry resource > Keys and Endpoint
# If omitted, falls back to Entra ID auth (requires az login or managed identity)
AZURE_API_KEY=your-api-key-here

# (Optional) Model deployment name -- default: computer-use-preview
# MODEL_DEPLOYMENT=computer-use-preview

# Required only for --live. Never enable this against a real control system.
# ALLOW_COMPUTER_CONTROL=1
