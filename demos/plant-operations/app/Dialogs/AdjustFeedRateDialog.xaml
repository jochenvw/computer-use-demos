<Window x:Class="plant_manager.Dialogs.AdjustFeedRateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Control — Adjust Feed Rate"
        Width="420" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFD4D0C8">
    <Border BorderBrush="#FF808080" BorderThickness="2" Margin="8">
        <StackPanel Margin="12">
            <TextBlock Text="ADJUST FEED RATE" FontWeight="Bold" FontSize="13"
                       Background="#FF000080" Foreground="White" Padding="6,4"/>

            <TextBlock Text="Current Feed Rate (%):" Margin="0,12,0,4" FontSize="12"/>
            <TextBlock x:Name="CurrentValueText" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <TextBlock Text="New Feed Rate (%):" Margin="0,4,0,4" FontSize="12"/>
            <StackPanel Orientation="Horizontal">
                <Button Content=" − " Width="32" Height="26" FontSize="14" FontWeight="Bold"
                        Click="Minus_Click" VerticalAlignment="Center"/>
                <TextBox x:Name="NewValueBox" Width="120"
                         FontSize="13" FontFamily="Consolas" Padding="4,2"
                         VerticalAlignment="Center" Margin="4,0"/>
                <Button Content=" + " Width="32" Height="26" FontSize="14" FontWeight="Bold"
                        Click="Plus_Click" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Valid range: 50 – 110 %" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Apply" Width="90" Height="28" Margin="0,0,8,0"
                        Click="Apply_Click" FontWeight="Bold"/>
                <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
