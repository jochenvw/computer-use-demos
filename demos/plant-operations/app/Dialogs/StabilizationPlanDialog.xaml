<Window x:Class="plant_manager.Dialogs.StabilizationPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Stabilization Plan"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFD4D0C8">
    <Border BorderBrush="#FF808080" BorderThickness="2" Margin="8">
        <StackPanel Margin="12">
            <TextBlock Text="APPLY STABILIZATION PLAN" FontWeight="Bold" FontSize="13"
                       Background="#FF006400" Foreground="White" Padding="6,4"/>

            <TextBlock Text="This will apply the following corrective actions:" Margin="0,12,0,8" FontSize="12"/>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox x:Name="ChkFeedRate" Content="Reduce feed rate by 5%" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkCooling" Content="Increase cooling target by 3 °C" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkRecycle" Content="Set recycle valve to AUTO" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkAckAlarms" Content="Acknowledge all active alarms" IsChecked="False" Margin="0,2"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Operator Justification:" Margin="0,4,0,4" FontSize="11"/>
            <TextBox x:Name="JustificationBox" Height="50" AcceptsReturn="True"
                     FontSize="12" FontFamily="Consolas" Padding="4,2"
                     Text="Applying standard stabilization per SOP"
                     VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Apply Plan" Width="110" Height="28" Margin="0,0,8,0"
                        Click="Apply_Click" FontWeight="Bold"/>
                <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
