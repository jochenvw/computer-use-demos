<Window x:Class="plant_manager.Dialogs.AcknowledgeAlarmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acknowledge Alarm"
        Width="460" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFD4D0C8">
    <Border BorderBrush="#FF808080" BorderThickness="2" Margin="8">
        <StackPanel Margin="12">
            <TextBlock Text="ACKNOWLEDGE ALARM" FontWeight="Bold" FontSize="13"
                       Background="#FF800000" Foreground="White" Padding="6,4"/>

            <TextBlock Text="Alarm Tag:" Margin="0,12,0,2" FontSize="11"/>
            <TextBlock x:Name="AlarmTagText" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>

            <TextBlock Text="Description:" Margin="0,4,0,2" FontSize="11"/>
            <TextBlock x:Name="AlarmDescText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock Text="Operator Notes:" Margin="0,4,0,4" FontSize="11"/>
            <TextBox x:Name="NotesBox" Height="50" AcceptsReturn="True"
                     FontSize="12" FontFamily="Consolas" Padding="4,2"
                     VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Confirm Acknowledge" Width="140" Height="28" Margin="0,0,8,0"
                        Click="Confirm_Click" FontWeight="Bold"/>
                <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
