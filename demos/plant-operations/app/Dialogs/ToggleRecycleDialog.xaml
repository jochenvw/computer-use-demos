<Window x:Class="plant_manager.Dialogs.ToggleRecycleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Control — Toggle Recycle Valve"
        Width="400" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFD4D0C8">
    <Border BorderBrush="#FF808080" BorderThickness="2" Margin="8">
        <StackPanel Margin="12">
            <TextBlock Text="TOGGLE RECYCLE VALVE" FontWeight="Bold" FontSize="13"
                       Background="#FF000080" Foreground="White" Padding="6,4"/>

            <TextBlock Text="Current Recycle Valve State:" Margin="0,16,0,4" FontSize="12"/>
            <TextBlock x:Name="CurrentStateText" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

            <TextBlock Text="Toggling will switch between AUTO and MANUAL-OPEN."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Confirm Toggle" Width="120" Height="28" Margin="0,0,8,0"
                        Click="Confirm_Click" FontWeight="Bold"/>
                <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
